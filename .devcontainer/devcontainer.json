{
  "name": "Datavloot Toolkit",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash -lc 'set -o pipefail; curl -LsSf https://astral.sh/uv/install.sh | sh && export PATH=\"$HOME/.local/bin:$PATH\" && uv sync --all-extras && npm ci --prefix datavloot_platform/crowsnest/frontend'",
  "forwardPorts": [3000, 3001, 8080, 2718, 2719],
  "portsAttributes": {
    "3000": {
      "label": "Dagster"
    },
    "3001": {
      "label": "Next.js frontend"
    },
    "8080": {
      "label": "Crows Nest"
    },
    "2718": {
      "label": "Marimo"
    },
    "2719": {
      "label": "Marimo apps"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ]
      }
    }
  }
}
